{
  "compilerOptions": {
    "outDir": "./build/",
    "noImplicitAny": true,
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "node",

    /* Linting */
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
